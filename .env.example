# Copy to .env (git-ignored). Without it, Saradi runs fully simulated.

# Voice: sim (dashboard "elder's phone") or bolna (real calls)
SARADI_VOICE=sim
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# Optional; defaults to your Bolna account's number
BOLNA_FROM_NUMBER=

# Family messages: sim (dashboard feed), telegram (bot, free) or whatsapp (Meta Cloud API)
SARADI_MESSENGER=sim
# Telegram: create a bot by messaging @BotFather on Telegram (/newbot) and paste its token here
TELEGRAM_BOT_TOKEN=
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v21.0

# Who the cold-start demo calls. Only use numbers of people who agreed to it.
SARADI_DEMO_ELDER_NAME=Ajji
SARADI_DEMO_ELDER_PHONE=
SARADI_DEMO_LANGUAGE=kannada
SARADI_DEMO_FAMILY_NAME=
SARADI_DEMO_FAMILY_PHONE=

SARADI_PORT=8765
# Leave unset to serve only this computer. 0.0.0.0 lets a phone on the same Wi-Fi connect (no password, so trusted networks only).
# SARADI_HOST=0.0.0.0
# SARADI_DB=data/saradi.db
